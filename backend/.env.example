# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins. Use "*" to allow any (dev only).
# e.g. CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose service "postgres")
DATABASE_URL=postgresql://sms:sms_password@localhost:5432/sms?schema=public

# Redis (matches docker-compose service "redis")
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
